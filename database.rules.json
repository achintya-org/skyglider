{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['x', 'z'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "msg": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "mode": { ".validate": "newData.isString() && newData.val().length <= 12" }
      }
    }
  }
}
